{
  "name": "ContextClues",
  "short_name": "ContextClues",
  "description": "A local, read-only dashboard for Claude Code. See how full the context window is, what is filling it, and how much working room is left.",
  "start_url": "/",
  "display": "browser",
  "background_color": "#131110",
  "theme_color": "#131110",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ]
}
