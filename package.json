{
  "name": "contextclues",
  "version": "0.2.0",
  "description": "A local, read-only dashboard showing what a running Claude Code session has in its context window: observed token usage, growth trajectory, composition, evidence, tools, and clues.",
  "keywords": [
    "claude",
    "claude-code",
    "context-window",
    "tokens",
    "observability",
    "llm",
    "ai-agent",
    "dashboard",
    "cli"
  ],
  "homepage": "https://ctxclues.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaxwellVolz/contextclues.git"
  },
  "bugs": {
    "url": "https://github.com/MaxwellVolz/contextclues/issues"
  },
  "license": "MIT",
  "author": "Maxwell Volz",
  "type": "module",
  "bin": {
    "contextclues": "bin/contextclues.js"
  },
  "files": [
    "bin/",
    ".next/",
    "!.next/cache/",
    "next.config.mjs",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "next dev -p 4310 -H 127.0.0.1",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "start": "next start -p 4310 -H 127.0.0.1",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "prepublishOnly": "rm -rf .next && npm run build && npm test"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "next": "^15.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.0"
  }
}
